# bookdown build products
_bookdown_files/
*_cache/
*_files/
!docs/*_files/

# R session
.Rhistory
.RData
.Rproj.user/

# bookdown new_session intermediates: each chapter is knitted to <name>.md and
# the result lands in output_dir. They are a build by-product, not part of the
# published site.
docs/*.md

# renv: track the lockfile and settings, not the library
renv/library/
renv/staging/
renv/python/
renv/sandbox/

# LaTeX intermediates
*.aux
*.log
*.toc
*.out
*.bbl
*.blg

# OS
.DS_Store
Thumbs.db

# bookdown new_session cache
*.rds
