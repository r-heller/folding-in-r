# bookdown build products
_bookdown_files/
*_cache/
*_files/

# knitr's default fig.path when a chapter is rendered on its own. A full
# bookdown build writes figures under docs/, so anything here is a by-product of
# someone running rmarkdown::render() on a single chapter -- which is the
# documented way to check a chapter knits, so the directory recurs.
figure/

# Chapter 1's figure chunk copies js/fold-figure.html to knitr's output.dir. A
# full build resolves that to docs/, which is where the iframe expects it; a
# standalone render of the chapter resolves it to the input directory and drops
# a copy here instead. The source of record is js/fold-figure.html.
/fold-figure.html

# The rendered site. Built by render-book.yml and deployed to gh-pages with
# clean: true, so nothing here needs to be tracked -- and a tracked copy means
# whoever clones the repository gets a rendered book older than the sources.
docs/

# R session
.Rhistory
Rplots.pdf   # stray default device output from headless runs
.RData
.Rproj.user/

# renv: track the lockfile and settings, not the library
renv/library/
renv/staging/
renv/python/
renv/sandbox/

# LaTeX intermediates
*.aux
*.log
*.toc
*.out
*.bbl
*.blg

# OS
.DS_Store
Thumbs.db

# bookdown new_session cache
#
# Under new_session: yes bookdown drops a <chapter>.rds beside each source file.
# The book's own artefacts live under data/processed/ and are committed: the
# grid is precomputed once, scripts/run-benchmark-grid.R is kept as the
# provenance record, and every chapter from Chapter 4 onward opens by reading
# one of them. They are negated back in below, and the negation is load-bearing.
*.rds
!data/processed/*.rds
# ...except smoke-test output, which must never be mistaken for the real grid.
data/processed/*-quick.rds

node_modules/
